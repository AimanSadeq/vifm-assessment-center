{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__Supabase__execute_sql",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/supabase-readonly.sh\"",
            "timeout": 10,
            "statusMessage": "Checking the SQL is read-only"
          }
        ]
      }
    ]
  }
}
